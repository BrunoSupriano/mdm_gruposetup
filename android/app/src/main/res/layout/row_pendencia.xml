<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/glass_input"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <TextView
        android:id="@+id/txtPend"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:text="-" android:textColor="@color/white"
        android:textSize="14sp"/>
    <Button
        android:id="@+id/btnPend"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Resolver" android:textColor="@color/white" android:textAllCaps="false"
        android:textSize="13sp" android:minWidth="0dp" android:minHeight="0dp"
        android:paddingHorizontal="16dp" android:paddingVertical="8dp"
        android:background="@drawable/btn_primary" android:stateListAnimator="@null"/>
</LinearLayout>
