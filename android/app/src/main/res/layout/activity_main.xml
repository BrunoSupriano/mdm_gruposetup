<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootFrame"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/rootScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <!-- Header: título + engrenagem -->
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingBottom="18dp">

                <LinearLayout
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Setup MDM" android:textColor="@color/textOnDark"
                        android:textSize="26sp" android:textStyle="bold" android:letterSpacing="0.01"/>
                    <TextView
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Monitoramento do dispositivo corporativo"
                        android:textColor="@color/textMuted" android:textSize="13sp"
                        android:paddingTop="2dp"/>
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnConfig"
                    android:layout_width="44dp" android:layout_height="44dp"
                    android:src="@drawable/ic_gear"
                    android:background="@drawable/circle_glass"
                    android:scaleType="centerInside"
                    android:padding="10dp"
                    android:contentDescription="Configurações"/>
            </LinearLayout>

            <!-- Status pill -->
            <TextView
                android:id="@+id/statusPill"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Verificando..." android:textColor="@color/textOnDark"
                android:textSize="14sp" android:textStyle="bold"
                android:paddingHorizontal="18dp" android:paddingVertical="10dp"
                android:background="@drawable/pill_ok" android:layout_marginBottom="18dp"/>

            <!-- Card: última localização -->
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/glass_card"
                android:padding="20dp" android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="ÚLTIMA LOCALIZAÇÃO" android:textColor="@color/textMuted"
                    android:textSize="12sp" android:textStyle="bold" android:letterSpacing="0.08"/>
                <TextView
                    android:id="@+id/txtLastLoc"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Aguardando primeiro envio" android:textColor="@color/textOnDark"
                    android:textSize="18sp" android:textStyle="bold" android:paddingTop="8dp"/>
                <TextView
                    android:id="@+id/txtLastTime"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="—" android:textColor="@color/textMuted"
                    android:textSize="13sp" android:paddingTop="2dp"/>

                <TextView
                    android:id="@+id/txtEnvioStatus"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="" android:textColor="@color/ok" android:textSize="13sp"
                    android:paddingTop="8dp" android:visibility="gone"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEnviarAgora"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Enviar localização agora" android:textColor="@color/white"
                    android:textAllCaps="false" android:layout_marginTop="14dp"
                    android:insetTop="0dp" android:insetBottom="0dp"
                    app:backgroundTint="@color/primary" app:cornerRadius="14dp" app:elevation="0dp"/>
                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Envio automático 1x por dia"
                    android:textColor="@color/textMuted" android:textSize="11sp"
                    android:gravity="center" android:paddingTop="8dp"/>
            </LinearLayout>

            <!-- Card: cadastro -->
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/glass_card"
                android:padding="20dp" android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="CADASTRO DO DISPOSITIVO" android:textColor="@color/textMuted"
                    android:textSize="12sp" android:textStyle="bold" android:letterSpacing="0.08"/>

                <!-- Form (visível se ainda não cadastrado) -->
                <LinearLayout
                    android:id="@+id/formCadastro"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:paddingTop="12dp">

                    <TextView
                        android:id="@+id/txtReconfirmAviso"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Confirmação mensal: confirme quem está com este aparelho para manter o cadastro em dia."
                        android:textColor="@color/redSoft" android:textSize="13sp"
                        android:background="@drawable/glass_red" android:padding="12dp"
                        android:layout_marginBottom="12dp" android:visibility="gone"/>

                    <!-- Pergunta inicial: individual ou equipe -->
                    <TextView
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Este aparelho é de uso individual ou de equipe?"
                        android:textColor="@color/textOnDark"
                        android:textSize="14sp" android:paddingBottom="8dp"/>
                    <LinearLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTipoIndividual"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:layout_marginEnd="6dp"
                            android:text="Individual" android:textColor="@color/textOnDark"
                            android:textAllCaps="false"
                            android:insetTop="0dp" android:insetBottom="0dp"
                            app:backgroundTint="@color/glassFill"
                            app:strokeColor="@color/glassStroke" app:strokeWidth="1dp"
                            app:cornerRadius="12dp"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTipoEquipe"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:layout_marginStart="6dp"
                            android:text="Equipe" android:textColor="@color/textOnDark"
                            android:textAllCaps="false"
                            android:insetTop="0dp" android:insetBottom="0dp"
                            app:backgroundTint="@color/glassFill"
                            app:strokeColor="@color/glassStroke" app:strokeWidth="1dp"
                            app:cornerRadius="12dp"/>
                    </LinearLayout>

                    <!-- Individual: colaborador -->
                    <LinearLayout
                        android:id="@+id/boxIndividual"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:visibility="gone">
                        <TextView
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="Seu nome ou matrícula" android:textColor="@color/textOnDark"
                            android:textSize="14sp" android:paddingTop="16dp" android:paddingBottom="6dp"/>
                        <AutoCompleteTextView
                            android:id="@+id/autoColaborador"
                            android:layout_width="match_parent" android:layout_height="52dp"
                            android:hint="Digite para buscar..." android:textColorHint="@color/textMuted"
                            android:textColor="@color/textOnDark" android:textSize="15sp"
                            android:background="@drawable/glass_input" android:paddingHorizontal="14dp"
                            android:completionThreshold="2" android:inputType="text" android:imeOptions="actionSearch"/>
                    </LinearLayout>

                    <!-- Equipe: eqps_ativas -->
                    <LinearLayout
                        android:id="@+id/boxEquipe"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:visibility="gone">
                        <TextView
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="Equipe" android:textColor="@color/textOnDark"
                            android:textSize="14sp" android:paddingTop="16dp" android:paddingBottom="6dp"/>
                        <AutoCompleteTextView
                            android:id="@+id/autoEquipe"
                            android:layout_width="match_parent" android:layout_height="52dp"
                            android:hint="Digite a equipe ou processo..." android:textColorHint="@color/textMuted"
                            android:textColor="@color/textOnDark" android:textSize="15sp"
                            android:background="@drawable/glass_input" android:paddingHorizontal="14dp"
                            android:completionThreshold="2" android:inputType="text" android:imeOptions="actionSearch"/>
                    </LinearLayout>

                    <!-- Pergunta: tem patrimônio? -->
                    <TextView
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Este aparelho tem número de patrimônio?"
                        android:textColor="@color/textOnDark"
                        android:textSize="14sp" android:paddingTop="18dp" android:paddingBottom="8dp"/>
                    <LinearLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTemPatSim"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:layout_marginEnd="6dp"
                            android:text="Sim, tenho" android:textColor="@color/textOnDark"
                            android:textAllCaps="false"
                            android:insetTop="0dp" android:insetBottom="0dp"
                            app:backgroundTint="@color/glassFill"
                            app:strokeColor="@color/glassStroke" app:strokeWidth="1dp"
                            app:cornerRadius="12dp"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTemPatNao"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:layout_marginStart="6dp"
                            android:text="Não tenho" android:textColor="@color/textOnDark"
                            android:textAllCaps="false"
                            android:insetTop="0dp" android:insetBottom="0dp"
                            app:backgroundTint="@color/glassFill"
                            app:strokeColor="@color/glassStroke" app:strokeWidth="1dp"
                            app:cornerRadius="12dp"/>
                    </LinearLayout>

                    <!-- Campo patrimônio -->
                    <LinearLayout
                        android:id="@+id/boxPatrimonio"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:visibility="gone">
                        <TextView
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="Patrimônio (até 7 dígitos)" android:textColor="@color/textOnDark"
                            android:textSize="14sp" android:paddingTop="16dp" android:paddingBottom="6dp"/>
                        <EditText
                            android:id="@+id/edtPatrimonio"
                            android:layout_width="match_parent" android:layout_height="52dp"
                            android:hint="Ex.: 1234567" android:textColorHint="@color/textMuted"
                            android:textColor="@color/textOnDark" android:textSize="15sp"
                            android:background="@drawable/glass_input" android:paddingHorizontal="14dp"
                            android:inputType="number" android:maxLength="7"/>
                    </LinearLayout>

                    <!-- Campo IMEI -->
                    <LinearLayout
                        android:id="@+id/boxImei"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:visibility="gone">
                        <TextView
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="IMEI do aparelho" android:textColor="@color/textOnDark"
                            android:textSize="14sp" android:paddingTop="16dp" android:paddingBottom="6dp"/>
                        <LinearLayout
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical">
                            <EditText
                                android:id="@+id/edtImei"
                                android:layout_width="0dp" android:layout_height="52dp"
                                android:layout_weight="1"
                                android:hint="Ex.: 356938035643809" android:textColorHint="@color/textMuted"
                                android:textColor="@color/textOnDark" android:textSize="15sp"
                                android:background="@drawable/glass_input" android:paddingHorizontal="14dp"
                                android:inputType="number" android:maxLength="17"/>
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnDiscarImei"
                                style="@style/Widget.MaterialComponents.Button"
                                android:layout_width="wrap_content" android:layout_height="52dp"
                                android:layout_marginStart="8dp"
                                android:text="*#06#" android:textColor="@color/white"
                                android:textAllCaps="false" android:textSize="13sp"
                                android:minWidth="0dp"
                                android:insetTop="0dp" android:insetBottom="0dp"
                                android:paddingHorizontal="14dp"
                                app:backgroundTint="@color/glassFill"
                                app:strokeColor="@color/glassStroke" app:strokeWidth="1dp"
                                app:cornerRadius="12dp" app:elevation="0dp"/>
                        </LinearLayout>
                        <TextView
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="Toque em *#06# para o aparelho mostrar o IMEI."
                            android:textColor="@color/textMuted" android:textSize="11sp"
                            android:paddingTop="6dp"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtCadastroErro"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="" android:textColor="@color/error" android:textSize="13sp"
                        android:paddingTop="10dp" android:visibility="gone"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSalvarCadastro"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Salvar cadastro" android:textColor="@color/white"
                        android:textAllCaps="false" android:layout_marginTop="16dp"
                        android:insetTop="0dp" android:insetBottom="0dp"
                        app:backgroundTint="@color/primary" app:cornerRadius="14dp" app:elevation="0dp"/>
                    <TextView
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Depois de salvar, o cadastro não pode ser alterado."
                        android:textColor="@color/textMuted" android:textSize="11sp"
                        android:gravity="center" android:paddingTop="8dp"/>
                </LinearLayout>

                <!-- Travado (visível depois de cadastrado) -->
                <LinearLayout
                    android:id="@+id/cadastroTravado"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:paddingTop="12dp" android:visibility="gone">
                    <TextView
                        android:id="@+id/txtColabNome"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="—" android:textColor="@color/textOnDark"
                        android:textSize="18sp" android:textStyle="bold"/>
                    <TextView
                        android:id="@+id/txtColabCargo"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="" android:textColor="@color/textMuted" android:textSize="13sp"/>
                    <TextView
                        android:id="@+id/txtDoc"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="" android:textColor="@color/textOnDark" android:textSize="15sp"
                        android:paddingTop="10dp"/>
                    <TextView
                        android:id="@+id/txtCadInfo"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="🔒 Cadastro concluído" android:textColor="@color/ok"
                        android:textSize="12sp" android:paddingTop="10dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Banner: atualização disponível (visível só quando há update) -->
            <LinearLayout
                android:id="@+id/updateBanner"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/glass_card" android:padding="18dp"
                android:layout_marginBottom="16dp" android:visibility="gone">
                <TextView
                    android:id="@+id/txtUpdateTitulo"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Atualização disponível" android:textColor="@color/textOnDark"
                    android:textSize="15sp" android:textStyle="bold"/>
                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Uma nova versão do app está pronta para instalar."
                    android:textColor="@color/textMuted" android:textSize="12sp" android:paddingTop="2dp"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAtualizarMain"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Atualizar agora" android:textColor="@color/white"
                    android:textAllCaps="false" android:layout_marginTop="12dp"
                    android:insetTop="0dp" android:insetBottom="0dp"
                    app:backgroundTint="@color/primary" app:cornerRadius="14dp" app:elevation="0dp"/>
            </LinearLayout>

            <!-- Aviso: não desinstalar (vermelho suave, glass) -->
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:background="@drawable/glass_red" android:padding="16dp"
                android:layout_marginBottom="6dp">
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="⚠" android:textColor="@color/redSoft"
                    android:textSize="20sp" android:paddingEnd="12dp"/>
                <TextView
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Não desinstale este aplicativo. Ele é gerenciado pela TI da empresa."
                    android:textColor="@color/redSoft" android:textSize="13sp"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Overlay: sem conexão -->
    <LinearLayout
        android:id="@+id/offlineOverlay"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:gravity="center"
        android:background="@drawable/bg_gradient"
        android:padding="40dp" android:visibility="gone"
        android:clickable="true" android:focusable="true">

        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="📡" android:textSize="52sp"/>
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Sem conexão" android:textColor="@color/textOnDark"
            android:textSize="24sp" android:textStyle="bold" android:gravity="center"
            android:paddingTop="16dp"/>
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Conecte-se à internet (Wi-Fi ou dados móveis) para continuar o cadastro e o envio de localização."
            android:textColor="@color/textMuted" android:textSize="14sp" android:gravity="center"
            android:paddingTop="10dp"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTentarNovamente"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Tentar novamente" android:textColor="@color/white"
            android:textAllCaps="false" android:layout_marginTop="24dp"
            android:insetTop="0dp" android:insetBottom="0dp"
            android:paddingHorizontal="28dp"
            app:backgroundTint="@color/primary" app:cornerRadius="14dp" app:elevation="0dp"/>
    </LinearLayout>

</FrameLayout>
